# Demo mode enabled by default for local prototype
SUPPORTGENIE_DEMO_MODE=true

# Azure AI Foundry (placeholder values)
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-endpoint.openai.azure.com/
AZURE_AI_FOUNDRY_API_KEY=your-foundry-api-key

# Azure AI Search (placeholder values)
AZURE_AI_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_AI_SEARCH_API_KEY=your-search-api-key
AZURE_AI_SEARCH_INDEX_NAME=supportgenie-kb

# SQL Server (placeholder values)
SQL_SERVER_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=JotDesk;Uid=app_user;******;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;
