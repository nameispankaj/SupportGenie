# SupportGenie runtime
SUPPORTGENIE_DEMO_MODE=true
SUPPORTGENIE_API_HOST=127.0.0.1
SUPPORTGENIE_API_PORT=8000
SUPPORTGENIE_FRONTEND_ORIGIN=http://127.0.0.1:5500

# SQL Server connection (used when SUPPORTGENIE_DEMO_MODE=false)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=JotDeskBuddy_Test
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER_AUTH_MODE=sql
SQL_SERVER_USERNAME=your_sql_username
SQL_SERVER_PASSWORD=your_sql_password
SQL_SERVER_ENCRYPT=true
SQL_SERVER_TRUST_SERVER_CERTIFICATE=true
SQL_SERVER_CONNECTION_TIMEOUT=30

# Use SQL_SERVER_AUTH_MODE=windows for integrated authentication and leave username/password blank.

# Configurable table/column mapping assumptions (update to match actual schema)
SUPPORTGENIE_TICKETS_TABLE=Tickets
SUPPORTGENIE_TICKETCHAT_TABLE=TicketChat
SUPPORTGENIE_TICKETFOLLOWUPS_TABLE=TicketFollowups
SUPPORTGENIE_TICKETEMAILMESSAGES_TABLE=TicketEmailMessages
SUPPORTGENIE_TICKET_ID_COLUMN=ticket_id
SUPPORTGENIE_TICKET_SUBJECT_COLUMN=subject
SUPPORTGENIE_TICKET_DESCRIPTION_COLUMN=description
SUPPORTGENIE_TICKET_STATUS_COLUMN=status
SUPPORTGENIE_TICKET_URGENCY_COLUMN=urgency
SUPPORTGENIE_TICKET_REPORTED_AT_COLUMN=report_date
SUPPORTGENIE_TICKET_CLIENT_COLUMN=client_name
SUPPORTGENIE_TICKET_PROJECT_COLUMN=project_name
SUPPORTGENIE_TICKET_MODULE_COLUMN=module_name
SUPPORTGENIE_TICKET_ASSIGNEE_COLUMN=assigned_to
SUPPORTGENIE_TICKET_REPORT_METHOD_COLUMN=report_method
